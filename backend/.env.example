# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# 1. Local MongoDB (current setup)
MONGO_URI=mongodb://127.0.0.1:27017/quantiml_db

# 2. Cloud MongoDB Atlas (for later transition)
# MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.abcde.mongodb.net/quantiml_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d
