        {
          "name": "POST Log Transaction (Swiggy ₹247 -> ₹3 Spare Change)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
