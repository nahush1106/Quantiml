      "item": [
        {
          "name": "POST User Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Arjun Sharma\",\n  \"email\": \"arjun.postman@example.com\",\n  \"phone\": \"9876500001\",\n  \"password\": \"Password@123\",\n  \"roundUpTarget\": 10,\n  \"roundUpMultiplier\": 1.0,\n  \"autoInvestThreshold\": 500.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "register"]
            },
            "description": "Registers a new user account with initial round-up settings and returns a JWT token."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Registration status code is 201 (or 400 if user exists)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"authToken\", jsonData.data.token);",
                  "    pm.collectionVariables.set(\"userId\", jsonData.data.user.id || jsonData.data.user._id);",
                  "    console.log(\"[Postman] Auth token saved:\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
