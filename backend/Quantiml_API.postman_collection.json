            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 247.0,\n  \"merchant\": \"Swiggy Food Delivery\",\n  \"category\": \"DISCRETIONARY\",\n  \"source\": \"MANUAL\",\n  \"roundToMultiple\": 10,\n  \"customMultiplier\": 1.0,\n  \"notes\": \"Lunch order - testing round up to nearest ₹10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            },
            "description": "Logs an expense. Automatically calculates nearest ₹10 round-up (₹250) and ₹3 spare change."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Spare change correctly computed as ₹3.00\", function () {",
                  "    pm.expect(jsonData.data.amount).to.eql(247.0);",
                  "    pm.expect(jsonData.data.roundedAmount).to.eql(250.0);",
                  "    pm.expect(jsonData.data.spareChange).to.eql(3.0);",
                  "    pm.expect(jsonData.data.status).to.eql(\"ROUNDED_UP\");",
                  "});",
                  "if (jsonData.data && (jsonData.data._id || jsonData.data.id)) {",
                  "    pm.collectionVariables.set(\"transactionId\", jsonData.data._id || jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
